+
+    var runs = ArrayList(Run).empty;
+    defer runs.deinit(gpa);
+    try buildRuns(gpa, &runs, classes, &cps, @intCast(cps.len));
+    try resolveExplicit(&runs, 0);
+    for (runs.items) |*run| run.orig_class = run.class;

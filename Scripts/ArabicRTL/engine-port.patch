+}
+
+const ArabicOracleGlyph = struct {
+    glyph: u32,
+    x: f64,
+    y: f64,
+
+    fn lessThan(_: void, a: ArabicOracleGlyph, b: ArabicOracleGlyph) bool {
+        if (a.x != b.x) return a.x < b.x;
+        if (a.y != b.y) return a.y < b.y;
+        return a.glyph < b.glyph;
+    }
+};
+
+// CoreText resolves and shapes the entire natural-direction line here. This
+// oracle does not use Ghostty's bidi runs, forced embedding, or cell mapping.
+fn arabicNaturalCoreTextOracle(
+    alloc: Allocator,
+    shaper: *Shaper,
+    grid: *SharedGrid,
+    text: []const u8,
+) ![]ArabicOracleGlyph {
+    const utf16 = try std.unicode.utf8ToUtf16LeAlloc(alloc, text);
+    defer alloc.free(utf16);
+    const str = try macos.foundation.String.createWithCharactersNoCopy(utf16);
+    defer str.release();
+    const index = (try grid.getIndex(alloc, 0x0645, .regular, null)).?;
+    const attrs = try shaper.getFont(grid, index);
+    const attributed = try macos.foundation.AttributedString.create(str, attrs);
+    defer attributed.release();
+    const options = try macos.foundation.Dictionary.create(&.{}, &.{});
+    defer options.release();
+    const setter = try macos.text.Typesetter.createWithAttributedStringAndOptions(attributed, options);
+    defer setter.release();
+    const line = try setter.createLine(.{ .location = 0, .length = 0 });
+    defer line.release();
+    var result: std.ArrayList(ArabicOracleGlyph) = .empty;
+    errdefer result.deinit(alloc);
+    var arena = std.heap.ArenaAllocator.init(alloc);
+    defer arena.deinit();
+    const runs = line.getGlyphRuns();
+    for (0..runs.getCount()) |i| {
+        const run = runs.getValueAtIndex(macos.text.Run, i);
+        const glyphs = run.getGlyphsPtr() orelse try run.getGlyphs(arena.allocator());
+        const positions = run.getPositionsPtr() orelse try run.getPositions(arena.allocator());
+        for (glyphs, positions) |glyph, position| {
+            try result.append(alloc, .{ .glyph = glyph, .x = position.x, .y = position.y });
+        }
+    }
+    std.mem.sort(ArabicOracleGlyph, result.items, {}, ArabicOracleGlyph.lessThan);
+    return result.toOwnedSlice(alloc);
+}

+test "shape Arabic requested corpus matches natural CoreText with ANSI and updates" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const phrases = [_][]const u8{
+        "مرحبا بالعالم",
+        "السلام عليكم",
+        "مرحبا Codex كيف حالك",
+        "الإصدار 163 يعمل بشكل جيد",
+        "السَّلَامُ عَلَيْكُمْ",
+        "Codex: تم تنفيذ المهمة بنجاح",
+        "مرحبا، كيف حالك؟",
+        "اختبار (Codex) ناجح",
+        "[Codex] مرحبا!",
+        "!مرحبا Codex?",
+        "printf: مرحبا path_163.txt",
+        "English 163 (Codex) stays left to right.",
+    };
+    var testdata = try testShaperWithFont(alloc, .arabic);
+    defer testdata.deinit();
+    for (phrases) |phrase| {
+        errdefer std.debug.print("Arabic oracle fixture: {s}\n", .{phrase});
+        const expected = try arabicNaturalCoreTextOracle(alloc, &testdata.shaper, testdata.grid, phrase);
+        defer alloc.free(expected);
+        var t = try terminal.Terminal.init(testing.io, alloc, .{ .cols = 120, .rows = 3 });
+        defer t.deinit(alloc);
+        t.modes.set(.grapheme_cluster, true);
+        var stream = t.vtStream();
+        defer stream.deinit();
+        var state: terminal.RenderState = .empty;
+        defer state.deinit(alloc);
+        for ([_][]const u8{ "\x1b[31m", "\x1b[32m", "\x1b[0m" }) |color| {
+            stream.nextSlice("\r\x1b[2K");
+            stream.nextSlice(color);
+            stream.nextSlice(phrase);
+            stream.nextSlice("\x1b[0m");
+            try state.update(alloc, &t);
+            const row = state.row_data.get(0).cells.slice();
+            var logical: std.ArrayList(u21) = .empty;
+            defer logical.deinit(alloc);
+            for (row.items(.raw), row.items(.grapheme)) |cell, marks| {
+                if (cell.codepoint() == 0) break;
+                try logical.append(alloc, @intCast(cell.codepoint()));
+                if (cell.hasGrapheme()) try logical.appendSlice(alloc, marks);
+            }
+            var decoded: std.ArrayList(u21) = .empty;
+            defer decoded.deinit(alloc);
+            var utf8 = (try std.unicode.Utf8View.init(phrase)).iterator();
+            while (utf8.nextCodepoint()) |cp| try decoded.append(alloc, cp);
+            try testing.expectEqualSlices(u21, decoded.items, logical.items);
+
+            var actual: std.ArrayList(ArabicOracleGlyph) = .empty;
+            defer actual.deinit(alloc);
+            var it = testdata.shaper.runIterator(.{ .grid = testdata.grid, .cells = row });
+            while (try it.next(alloc)) |run| {
+                const cells = try testdata.shaper.shape(run);
+                for (cells) |cell| {
+                    try testing.expect(cell.x < run.cells);
+                    try testing.expect(@as(u32, run.offset) + cell.x < 120);
+                    const column: f64 = @floatFromInt(@as(u32, run.offset) + cell.x);
+                    const width: f64 = @floatFromInt(run.grid.metrics.cell_width);
+                    try actual.append(alloc, .{
+                        .glyph = cell.glyph_index,
+                        .x = column * width + @as(f64, @floatFromInt(cell.x_offset)),
+                        .y = @floatFromInt(cell.y_offset),
+                    });
+                }
+            }
+            std.mem.sort(ArabicOracleGlyph, actual.items, {}, ArabicOracleGlyph.lessThan);
+            try testing.expectEqual(expected.len, actual.items.len);
+            for (expected, actual.items, 0..) |want, got, index| {
+                if (want.glyph != got.glyph) {
+                    std.debug.print("[DEBUG-rtl-oracle] mismatch={d} cell_width={d} expected={any} actual={any}\n", .{ index, testdata.grid.metrics.cell_width, expected, actual.items });
+                }
+                try testing.expectEqual(want.glyph, got.glyph);
+            }
+        }
+    }
+}
